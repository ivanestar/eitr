# ==============================================================================
# EITR Evals: LLM API Keys & Model Configuration
# Copy this file to .env and insert your real API keys.
# Note: .env is gitignored and will never be committed.
# ==============================================================================

# Anthropic Claude API Key (Required for --sonnet, --opus, --haiku)
# Get key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Google Gemini API Key (Required for --flash, --pro)
# Get key at: https://aistudio.google.com/
GEMINI_API_KEY=

# OpenAI API Key (Required for --gpt4o, --mini, --o3)
# Get key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Optional: Override default models explicitly if needed
# ANTHROPIC_MODEL=claude-sonnet-5
# GEMINI_MODEL=gemini-3.7-flash
# OPENAI_MODEL=gpt-4o-mini

# ==============================================================================
# TMS / MCP Bridge Integration Secrets
# Only needed when developing or manually testing the generated
# packages/engine/src/plan/templates/mcp-server.ts TMS adapters against a real
# instance (e.g. running the bridge by hand, or an eval that hits a live TMS).
# Fill in only the section for the provider you're actually testing — all
# optional. These are the exact same variable names the generated project's
# own .mcp.json / .env.example expect (see env-example.ts / mcp-configs.ts).
# ==============================================================================

# --- Azure DevOps (ado / azure / azure-devops) ---
# Org/project come from your ADO URL: https://dev.azure.com/<ORG>/<PROJECT>
# PAT: dev.azure.com -> User settings (top right) -> Personal access tokens -> New Token.
#      Needs "Work Items (Read)" + "Test Management (Read & Write)" scopes.
#      Looks like a 52-char base64-ish string, e.g. 4x9k2mZ...9pQ (shown ONLY once at creation).
# Run/point IDs are numeric, visible in the URL when viewing a Test Run / Test Point in ADO.
# Plan ID: numeric, visible in the URL when viewing a Test Plan under Test Plans in ADO.
#          Needed by mcp__tms__get_suite_context / mcp__tms__list_test_plans / mcp__tms__create_test_run.
AZURE_DEVOPS_ORG=          # e.g. contoso
AZURE_DEVOPS_PROJECT=      # e.g. MyProject
AZURE_DEVOPS_PAT=          # e.g. 4x9k2mZqW7bT1nR8sJ5vL3cH6dF0gY2aP9eK4xM1wQ7rT3nB (example shape only)
AZURE_DEVOPS_RUN_ID=       # e.g. 1842
AZURE_DEVOPS_TEST_POINT_ID= # e.g. 5031
AZURE_DEVOPS_PLAN_ID=      # e.g. 17

# --- TestRail (testrail) ---
# Host: your TestRail site root, e.g. https://yourcompany.testrail.io
# API key: TestRail -> My Settings (top right) -> API Keys -> Add Key.
#          Looks like a mixed-case alphanumeric string, e.g. aB3xY9zK2mQ7pR5t.
# Run ID: numeric, visible in the URL when viewing a Test Run in TestRail.
# Project/Section/Suite ID: numeric, visible in the respective URLs in TestRail. Section ID
#                            is needed for mcp__tms__create_issue (a case must live in a
#                            section); Suite ID is optional, used by mcp__tms__create_test_run.
TESTRAIL_HOST=             # e.g. https://yourcompany.testrail.io
TESTRAIL_USERNAME=         # e.g. you@yourcompany.com
TESTRAIL_API_KEY=          # e.g. aB3xY9zK2mQ7pR5t (example shape only)
TESTRAIL_RUN_ID=           # e.g. 217
TESTRAIL_PROJECT_ID=       # e.g. 3 (used by mcp__tms__search / mcp__tms__list_test_plans)
TESTRAIL_SUITE_ID=         # e.g. 5 (optional, used by mcp__tms__create_test_run)
TESTRAIL_SECTION_ID=       # e.g. 12 (used by mcp__tms__create_issue)

# --- Jira (jira, plain issue fetch + full issue CRUD via mcp__tms__*) ---
# Host: your Atlassian site, e.g. https://yourcompany.atlassian.net
# API token: id.atlassian.com/manage-profile/security/api-tokens -> Create API token.
#            Looks like a long alphanumeric string, e.g. ATATT3xFfGF0abc123...xyz.
# Project key: the short prefix on your issue keys (e.g. "PROJ" in PROJ-123). Needed by
#              mcp__tms__create_issue unless you pass projectKey explicitly per call.
JIRA_HOST=                 # e.g. https://yourcompany.atlassian.net
JIRA_EMAIL=                # e.g. you@yourcompany.com
JIRA_API_TOKEN=            # e.g. ATATT3xFfGF0abc123def456ghi789 (example shape only)
JIRA_PROJECT_KEY=          # e.g. PROJ

# --- Jira Xray (xray) — also reuses JIRA_PROJECT_KEY above for mcp__tms__create_issue ---
# Cloud: Jira Settings -> Apps -> Xray -> API Keys -> Create API Key.
#        CLIENT_ID looks like a UUID (e.g. 8f14e45f-ceea-4c9e-9f1a-2b3c4d5e6f70),
#        CLIENT_SECRET is a long opaque string.
# Server/DC fallback: reuses JIRA_HOST + JIRA_API_TOKEN above as a PAT (fetch only, no publish).
XRAY_CLIENT_ID=            # e.g. 8f14e45f-ceea-4c9e-9f1a-2b3c4d5e6f70 (example shape only)
XRAY_CLIENT_SECRET=        # long opaque string from the same Xray API Key screen
XRAY_TEST_EXECUTION_KEY=   # e.g. PROJ-456 (the Test Execution issue key to publish results into)

# --- Zephyr Scale (zephyr) ---
# API token: Jira Settings -> Apps -> Zephyr Scale -> API Access Tokens -> Create/Access Token.
#            Looks like a long dot-separated string, similar in shape to a JWT.
ZEPHYR_API_TOKEN=          # long JWT-like string from Zephyr Scale API Access Tokens
ZEPHYR_BASE_URL=           # default: https://api.zephyrscale.smartbear.com/v2 (leave unset to use default)
ZEPHYR_PROJECT_KEY=        # e.g. PROJ
ZEPHYR_TEST_CYCLE_KEY=     # e.g. PROJ-C1

# --- Playwright MCP proxy passthrough (optional, for corporate proxies) ---
HTTP_PROXY=                # e.g. http://proxy.yourcompany.com:8080
HTTPS_PROXY=               # e.g. http://proxy.yourcompany.com:8080
NODE_EXTRA_CA_CERTS=       # e.g. C:\certs\corporate-ca.pem (path to a PEM file)
PLAYWRIGHT_DOWNLOAD_HOST=  # e.g. https://internal-mirror.yourcompany.com/playwright
